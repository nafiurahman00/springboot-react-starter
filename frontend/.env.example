# Copy this file to ".env" if you need to point the frontend at a different API.
#
# Leave it EMPTY (or unset) in development: the Vite proxy in vite.config.js
# forwards /api -> http://localhost:8080 for you.
#
# In production (after `npm run build`), set this to your deployed backend URL:
# VITE_API_URL=https://api.your-domain.com
VITE_API_URL=
